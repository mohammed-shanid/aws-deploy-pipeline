# Copy to .env for local runs (.env is gitignored). Placeholders only.
# In AWS, DEMO_SECRET comes from SSM Parameter Store (SecureString) at container start.

# dev | staging | prod. Unset is treated as prod. DEMO_SECRET is optional only in dev.
APP_ENV=dev
DEMO_SECRET=replace-me
# Set by the deploy to the full git SHA of the release.
GIT_SHA=local
# Bind address. Defaults: 127.0.0.1 and 8000.
HOST=127.0.0.1
PORT=8000
