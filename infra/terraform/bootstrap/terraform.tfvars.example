# Copy to terraform.tfvars (gitignored) and fill in. No secrets belong here.
aws_region         = "ap-south-1" # or us-east-1; must match the environment
owner              = "your-name"
budget_limit_usd   = 25 # cost-estimate.md: just above the ~$21/month estimate
budget_alert_email = "you@example.com"
