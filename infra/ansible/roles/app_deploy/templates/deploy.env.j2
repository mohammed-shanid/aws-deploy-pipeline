# {{ ansible_managed }}
# Read as KEY=VALUE data by /opt/app/bin/deploy. No secrets belong here.
IMAGE_REPO={{ image_repo }}
REGISTRY_AUTH={{ registry_auth }}
SECRETS_SOURCE={{ secrets_source }}
SECRET_PARAMETER={{ secret_parameter }}
APP_ENV={{ app_env }}
HEALTH_TIMEOUT_SECONDS={{ app_deploy_health_timeout_seconds }}
APP_DOMAIN={{ app_domain }}
TLS_CA_FILE={{ tls_cert_path if tls_mode == 'selfsigned' else '' }}
