# {{ ansible_managed }}
server_tokens off;

upstream app_backend {
    # One "server 127.0.0.1:<slot port>;" line, switched by /opt/app/bin/deploy.
    include {{ nginx_upstream_file }};
}

# Port 80: ACME challenges and a redirect. The redirect target is the configured
# name, not the request's Host header.
server {
    listen 80 default_server;
    server_name {{ app_domain }};

    location /.well-known/acme-challenge/ {
        root {{ nginx_acme_webroot }};
    }
    location / {
        return 301 https://{{ app_domain }}$request_uri;
    }
}

server {
    listen 443 ssl http2 default_server;
    server_name {{ app_domain }};

    ssl_certificate     {{ tls_cert_path }};
    ssl_certificate_key {{ tls_key_path }};
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:adp_tls:1m;
    ssl_session_timeout 1h;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age={{ nginx_hsts_max_age }}" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'self'; frame-ancestors 'none'" always;

    location / {
        proxy_pass http://app_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
}
